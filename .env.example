# Copy to .env and fill in BY HAND. Never commit .env.

# Postgres from docker-compose.yml (host port 5435).
DATABASE_URL="postgresql://aislice:aislice@localhost:5435/aislice"

# Base URL the app runs on locally.
APP_URL="http://localhost:3003"

# DeepSeek API key (batch categorisation + summary, text only). Create at https://platform.deepseek.com -> API keys.
DEEPSEEK_API_KEY=""

# Gemini API key (receipt image extraction). Use a project with NO billing account to stay on the free tier. Create at https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=""
